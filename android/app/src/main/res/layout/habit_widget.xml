<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/habit_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/habit_widget_background"
  android:orientation="vertical"
  android:padding="16dp">

  <TextView
    android:id="@+id/habit_widget_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Habit"
    android:textColor="#9EA4AD"
    android:textSize="12sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/habit_widget_progress"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="0/0"
    android:textColor="#F2F0EA"
    android:textSize="34sp"
    android:textStyle="bold" />

  <ProgressBar
    android:id="@+id/habit_widget_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="8dp"
    android:layout_marginTop="8dp"
    android:max="100"
    android:progress="0"
    android:progressTint="#B9E6C9"
    android:progressBackgroundTint="#2B313A" />

  <TextView
    android:id="@+id/habit_widget_remaining"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="Open Habit"
    android:textColor="#F2F0EA"
    android:textSize="14sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/habit_widget_next"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:maxLines="1"
    android:text="Next habit"
    android:textColor="#9EA4AD"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/habit_widget_streak"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Best streak 0d"
    android:textColor="#B9E6C9"
    android:textSize="12sp"
    android:textStyle="bold" />
</LinearLayout>
